# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
COMPAIN_SECRET_KEY=change-me-long-random
COMPAIN_ADMIN_USERNAME=admin
COMPAIN_ADMIN_PASSWORD=change-me-at-least-12-chars

# Self-hosted model. The llm service starts with the app and downloads the model on the first start
# (about 17 GB). LLM_MODEL: gemma (recommended), mistral, or none for no self-hosted model.
LLM_MODEL=gemma
COMPAIN_MODEL_NAME=gemma-4-26b-a4b
# "mock" gives a built-in test reply instead of the model.
COMPAIN_MODEL_BASE_URL=http://llm:8081/v1

# Hosted API (OpenAI-compatible). Example: Groq.
COMPAIN_HOSTED_API_BASE_URL=mock
COMPAIN_HOSTED_API_KEY=
COMPAIN_HOSTED_MODEL=llama-3.1-8b-instant

# Port of the app on the server (default 8080). With your own reverse proxy on the same server,
# 127.0.0.1:8080 keeps the app reachable only through the proxy.
# COMPAIN_PORT=8080

# Built-in HTTPS (Caddy) is OFF by default. Only for servers without their own proxy: set the domain that
# points to this server and remove the # before COMPOSE_PROFILES, then "docker compose up -d" starts Caddy.
# COMPAIN_DOMAIN=
# COMPOSE_PROFILES=https

# Self-hosted model server (llama.cpp). 6 threads fit an i7-8700.
LLM_THREADS=6
# Total context and parallel slots. Each slot gets LLM_CONTEXT / LLM_SLOTS tokens; set the same
# number as "Context window per request" in Server Management, Models (default 8192).
LLM_CONTEXT=16384
LLM_SLOTS=2

# The model runs on the processor. For an NVIDIA graphics card run ./scripts/llm.sh gpu, which adds
# LLM_DEVICE=gpu and COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml here.
# Graphics memory (MB) left free for the desktop when the model runs on the graphics card.
# LLM_GPU_RESERVE_MB=1024
